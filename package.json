{
  "name": "auto-aws-sso-creds",
  "projectName": "auto-aws-sso-creds",
  "description": "script to (almost)auto update aws sso credentials",
  "version": "1.0.4",
  "exports": "./src/app.ts",
  "types": "./dist/app.d.ts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelndev/aws-sso-creds-tool.git"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths && tsc",
    "start": "node --import @swc-node/register/esm-register ./src/app.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "homepage": "https://github.com/leandrosalo/aws-sso-creds-tool#readme",
  "dependencies": {
    "@aws-sdk/client-sso": "^3.940.0",
    "@aws-sdk/client-sso-oidc": "^3.939.0",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.3",
    "confbox": "^0.2.2",
    "open": "^11.0.0"
  },
  "keywords": [
    "aws",
    "sso",
    "cloud",
    "credentials",
    "aws sso credentials",
    "aws authentication",
    "aws single sign on",
    "single sign on"
  ],
  "bin": {
    "auto-aws": "./bin/auto-aws.js"
  },
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=24"
  },
  "author": "",
  "devDependencies": {
    "@swc/cli": "^0.7.9",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
